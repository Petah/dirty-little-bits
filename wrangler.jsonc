{
  "name": "dirty-little-bits",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-01",
  "define": { "__filename": "\"server\"" },
  "alias": { "ws": "./cloudflare/ws-shim.js" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [{ "name": "GAME", "class_name": "GameRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
  "routes": [
    { "pattern": "dirty-little-bits.projectz.co.nz", "custom_domain": true }
  ]
}
